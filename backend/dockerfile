# Node 24.13.1
FROM node:24.13.1

WORKDIR /app

# Activer corepack (pour pnpm sans installation globale)
RUN corepack enable

# Copier manifests uniquement (optimisation cache Docker)
COPY package.json pnpm-lock.yaml ./

# Installer dépendances via pnpm (équivalent npm ci)
RUN pnpm install --frozen-lockfile

# Copier le reste du code
COPY . .

# Build TypeScript
RUN pnpm build && ls -la dist/

# Exposer le port backend
EXPOSE 3000

# Démarrage
CMD ["pnpm", "start"]