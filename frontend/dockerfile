FROM node:22-alpine

WORKDIR /app

ENV CI=true
ENV PNPM_CONFIG_IGNORE_SCRIPTS=false
ENV PNPM_CONFIG_AUTO_INSTALL_PEERS=true

RUN corepack enable

# 1. Copier workspace (IMPORTANT)
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY package.json ./

# 2. Copier tout le repo (monorepo)
COPY . .

# 3. Installer deps (workspace aware)
RUN pnpm install --no-frozen-lockfile --unsafe-perm

# 4. Build uniquement frontend
RUN pnpm --filter frontend build

EXPOSE 5173

# Vite preview (recommandé en prod-like container)
CMD ["pnpm", "--filter", "frontend", "dev", "--host", "0.0.0.0", "--port", "5173"]