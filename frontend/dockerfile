FROM node:20-alpine

WORKDIR /app

RUN corepack enable

# 1. Copier workspace (IMPORTANT)
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY package.json ./

# 2. Copier tout le repo (monorepo)
COPY . .

# 3. Installer deps (workspace aware)
RUN pnpm install --frozen-lockfile

# 4. Build uniquement frontend
RUN pnpm --filter frontend build

EXPOSE 5173

# Vite preview (recommandé en prod-like container)
CMD ["pnpm", "--filter", "frontend", "preview", "--host"]