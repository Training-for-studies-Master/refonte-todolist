# --- ÉTAPE 1 : Le Build ---
FROM node:22-alpine AS builder

WORKDIR /app
ENV CI=true
ENV PNPM_CONFIG_IGNORE_SCRIPTS=false
ENV PNPM_CONFIG_AUTO_INSTALL_PEERS=true

RUN corepack enable

COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY package.json ./
COPY . .

RUN pnpm install --no-frozen-lockfile --unsafe-perm

# CORRECTION : On reste à la racine de /app et on filtre uniquement sur le frontend
# Le drapeau --prod n'est pas mis ici car pnpm build a besoin des devDependencies (Vite, TypeScript, etc.)
RUN pnpm --filter frontend build

# --- ÉTAPE 2 : Le Serveur Statique ---
FROM nginx:alpine

# Le dossier dist se trouve bien dans le sous-dossier du monorepo
COPY --from=builder /app/refonte-todolist/frontend/dist /usr/share/nginx/html

# On expose et configure le port 5173
EXPOSE 5173
RUN sed -i 's/listen       80;/listen       5173;/' /etc/nginx/conf.d/default.conf

CMD ["nginx", "-g", "daemon off;"]