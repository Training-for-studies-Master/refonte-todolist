# --- ÉTAPE 1 : Le Build ---
FROM node:22-alpine AS builder

WORKDIR /app
ENV CI=true
ENV PNPM_CONFIG_IGNORE_SCRIPTS=false
ENV PNPM_CONFIG_AUTO_INSTALL_PEERS=true

RUN corepack enable

COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY package.json ./
COPY . .

RUN pnpm install --no-frozen-lockfile --unsafe-perm

# CHANGEMENT 1 : On se déplace directement dans le dossier du frontend pour le build
WORKDIR /app/refonte-todolist/frontend
RUN pnpm build

# --- ÉTAPE 2 : Le Serveur Statique ---
FROM nginx:alpine

# CHANGEMENT 2 : Le chemin est maintenant beaucoup plus simple et direct !
COPY --from=builder /app/refonte-todolist/frontend/dist /usr/share/nginx/html

# On expose et configure le port 5173
EXPOSE 5173
RUN sed -i 's/listen       80;/listen       5173;/' /etc/nginx/conf.d/default.conf

CMD ["nginx", "-g", "daemon off;"]