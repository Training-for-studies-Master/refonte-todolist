# --- ÉTAPE 1 : Le Build ---
FROM node:22-alpine AS builder

WORKDIR /app
ENV CI=true
ENV PNPM_CONFIG_IGNORE_SCRIPTS=false
ENV PNPM_CONFIG_AUTO_INSTALL_PEERS=true

RUN corepack enable

COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY package.json ./
COPY . .

RUN pnpm install --no-frozen-lockfile --unsafe-perm

# Build du frontend uniquement
RUN pnpm --filter frontend build

# --- ÉTAPE 2 : Le Serveur Statique ---
FROM nginx:alpine

# CORRECTION DU CHEMIN : 
# Puisque le build a réussi, les fichiers sont dans le dossier dist généré à la racine de l'espace de travail du builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Si l'erreur persiste avec /app/dist, tentez ce chemin alternatif :
# COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html
# ou tout simplement :
# COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# On expose et configure le port 5173
EXPOSE 5173
RUN sed -i 's/listen       80;/listen       5173;/' /etc/nginx/conf.d/default.conf

CMD ["nginx", "-g", "daemon off;"]